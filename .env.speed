# Configuration Ultra-Rapide pour Bot Opérateur 112
# Optimisée pour la vitesse maximale et minimum de temps perdu

# Authentification (à configurer avec vos identifiants)
USERNAME=your_username
PASSWORD=your_password

# Stratégie optimisée pour vitesse
DEFAULT_STRATEGY=smart
VEHICLE_THRESHOLD=5  # DEPRECATED - compatibilité
OPTIMIZATION_THRESHOLD=4  # Légèrement plus tolérant pour vitesse
DEPLOYMENT_THRESHOLD=8  # Très tolérant = moins de skip = plus de missions
PERSONNEL_THRESHOLD=2  # Tolérant pour personnel spécialisé en mode vitesse
MIN_CREDITS_THRESHOLD=800  # Seuil plus bas = plus de missions

# Performance Ultra-Optimisée
HEADLESS=true
PAGE_LOAD_TIMEOUT=10      # Réduit pour vitesse
ELEMENT_WAIT_TIMEOUT=3    # Très rapide
FAST_TIMEOUT=2            # Éléments critiques
SLOW_TIMEOUT=8            # Opérations complexes réduites
BROWSER_SLOW_MO=0         # Vitesse maximale
FAST_NAVIGATION=true      # Navigation optimisée

# Retry Ultra-Rapide (optimisé)
MAX_RETRIES=1             # 1 seule tentative max
RETRY_DELAY=0.3           # Délai minimal entre retry
MISSION_COOLDOWN=3        # Cooldown très court entre missions

# Logging minimal pour performance
LOG_LEVEL=WARNING         # Logs réduits
ENABLE_PERFORMANCE_LOGS=false

# Paramètres de vitesse maximale
MAX_CONCURRENT_MISSIONS=3  # Limite conservative mais rapide