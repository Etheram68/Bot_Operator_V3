{
  "_schema_version": "1.1",
  "_description": "Configuration des règles pour analyser les besoins manquants dans les alertes",
  "_last_updated": "2026-02-18",

  "personnel_mapping": {
    "_description": "Mapping du personnel spécialisé vers les véhicules appropriés. count_per_vehicle : nombre de personnels formés embarqués par véhicule (fallback : crew_size de vehicle_specs, puis 1).",
    "PLG": {
      "name": "Plongeur",
      "vehicles": ["VPL"],
      "priority": ["VPL"],
      "count_per_vehicle": {"VPL": 3},
      "description": "Personnel spécialisé dans les interventions subaquatiques (double formation PLG+SAV)"
    },
    "SAV": {
      "name": "Sauvetage Aquatique",
      "vehicles": ["VPL"],
      "priority": ["VPL"],
      "count_per_vehicle": {"VPL": 3},
      "description": "Personnel spécialisé dans le sauvetage aquatique (double formation PLG+SAV)"
    },
    "GRI": {
      "name": "GRIMP",
      "vehicles": ["VIMP"],
      "priority": ["VIMP"],
      "count_per_vehicle": {"VIMP": 5},
      "description": "Groupe d'Intervention en Milieu Périlleux"
    },
    "CYN": {
      "name": "Cynophile",
      "vehicles": ["CARS_DROGUE"],
      "priority": ["CARS_DROGUE"],
      "count_per_vehicle": {"CARS_DROGUE": 2},
      "description": "Unité cynophile (maître-chien)"
    },
    "MED": {
      "name": "Médecin",
      "vehicles": ["AMBULANCE", "SMUR(A)", "HELICOPTER"],
      "priority": ["SMUR(A)", "AMBULANCE", "HELICOPTER"],
      "description": "Médecin urgentiste"
    },
    "RAD": {
      "name": "Radiologie",
      "vehicles": ["VIRT"],
      "priority": ["VIRT"],
      "count_per_vehicle": {"VIRT": 4},
      "description": "Personnel de Radiologie"
    },
    "OPJ": {
      "name": "Officier de Police Judiciaire",
      "vehicles": ["VB", "GN", "PN"],
      "priority": ["VB", "GN", "PN"],
      "count_per_vehicle": {"VB": 4, "GN": 1, "PN": 1},
      "description": "Officier de police judiciaire pour enquêtes et procédures"
    },
    "USAR": {
      "name": "USAR (Sauvetage Déblaiement)",
      "vehicles": ["MaGec", "VDIP", "VEC"],
      "priority": ["MaGec", "VDIP", "VEC"],
      "count_per_vehicle": {"MaGec": 6, "VDIP": 4, "VEC": 4},
      "description": "Personnel Urban Search and Rescue / Sauvetage-Déblaiement"
    }
  },

  "other_needs_mapping": {
    "_description": "Mapping des autres besoins vers les types de véhicules",
    "water_sources": {
      "keywords": ["eau", "litre", "l", "water"],
      "exclusions": ["carburant", "essence", "diesel"],
      "type": "water_l",
      "description": "Besoins en eau pour extinction"
    },
    "fuel_sources": {
      "keywords": ["carburant", "essence", "diesel", "fuel"],
      "type": "fuel_l",
      "description": "Besoins en carburant"
    },
    "personnel_pompiers": {
      "keywords": ["pompier", "secouriste", "équipier", "firefighter"],
      "type": "personnel_pompiers",
      "description": "Personnel pompier générique"
    },
    "personnel_police": {
      "keywords": ["police", "gendarme", "agent"],
      "type": "personnel_policiers",
      "description": "Personnel police générique"
    },
    "personnel_medical": {
      "keywords": ["médecin", "infirmier", "samu", "medical"],
      "type": "personnel_medical",
      "description": "Personnel médical générique"
    },
    "equipment": {
      "keywords": ["équipement", "matériel", "outil", "equipment", "mousse"],
      "type": "equipment",
      "description": "Équipements et matériels spécialisés"
    },
    "time": {
      "keywords": ["heure", "minute", "temps", "time"],
      "type": "time",
      "description": "Besoins temporels (renforts)"
    }
  },

  "personnel_vehicle_mapping": {
    "_description": "Mapping des types de personnel générique vers les véhicules appropriés",
    "pompiers": {
      "vehicles": [
        "FPT",
        "FPT(SR)",
        "CCR(SR)",
        "CCF(M)",
        "CCF(S)",
        "FS",
        "VPC",
        "VTP(ers)",
        "VPI"
      ],
      "priority": [
        "VTP(ers)",
        "FPT",
        "CCR(SR)",
        "CCF(M)",
        "FPT(SR)",
        "FS",
        "VPI"
      ],
      "description": "Personnel pompier standard"
    },
    "policiers": {
      "vehicles": ["GN", "PN", "VR"],
      "priority": ["GN", "PN", "VR"],
      "description": "Personnel police standard"
    },
    "medical": {
      "vehicles": ["AMBULANCE", "DRAGON"],
      "priority": ["AMBULANCE", "DRAGON"],
      "description": "Personnel médical standard"
    },
    "general": {
      "vehicles": ["FPT", "GN", "PN"],
      "priority": ["FPT", "GN"],
      "description": "Personnel générique"
    }
  },

  "deduplication_rules": {
    "_description": "Règles de priorité pour éviter les doublons de détection",
    "VIMP": ["VGRIMP"],
    "BLS_CSL": ["BLS"],
    "FPT": ["FPT_VIM"],
    "FPT_SR": ["FPT", "VSR"],
    "FPT_BEA": ["FPT", "BEA"],
    "FPT_SR_BEA": ["FPT", "VSR", "BEA", "FPT_SR", "FPT_BEA"],
    "CARS_POLICE_VR": ["CARS_POLICE", "VR_CRS"],
    "CARS_POLICE_PATROUILLE_VR": [
      "CARS_POLICE",
      "CARS_POLICE_PATROUILLE",
      "VR_CRS"
    ],
    "CHEF_DE_GROUPE": ["VLHR"]
  },

  "parsing_patterns": {
    "_description": "Patterns regex pour parser les différents formats de besoins",
    "personnel_pattern": "(\\d+)x\\s+([A-Z][A-Z0-9]*)\\s*(?:\\([^)]+\\))?",
    "water_pattern": "(\\d+)(?:\\s*&nbsp;|\\s+)l(?:\\s+d[\\'’]?eau)?",
    "personnel_generic_patterns": {
      "pompiers": "(\\d+)(?:\\s+[Pp]ompiers?)",
      "policiers": "(\\d+)(?:\\s+[Pp]oliciers?)",
      "general": "(\\d+)(?:\\s+(?:équipiers?|secouristes?|agents?|personnels?))"
    }
  },

  "vehicle_capacity_priorities": {
    "_description": "Priorités pour la sélection des véhicules selon leurs capacités",
    "water_vehicles": {
      "large_capacity": ["CCF(S)", "CCGC", "FMOGP"],
      "medium_capacity": ["CEEM", "CCF(M)", "FPT", "FPT(SR)", "CCR(SR)"],
      "small_capacity": ["VPI"],
      "bonus_vehicles": ["FDGP", "RLC"]
    }
  }
}
