# Configuration Docker pour Bot Opérateur 112
# Copier ce fichier vers .env et remplir vos identifiants

# OBLIGATOIRE - Identifiants Opérateur 112
USERNAME=your_username_here
PASSWORD=your_password_here

# Configuration Docker spécifique
COMPOSE_PROJECT_NAME=bot-operateur-112
COMPOSE_FILE=docker-compose.yml

# Configuration réseau QNAP (optionnel)
# Adapter selon votre configuration réseau
QNAP_HOST_IP=192.168.1.29
MONITORING_PORT=8081  # Port pour interface web (8081 par défaut pour éviter conflit)

# Chemins de données sur QNAP (adapter selon vos shares)
# Exemple: /share/Container/bot-operateur
DATA_PATH=/share/Container/bot-operateur/data
CONFIG_PATH=/share/Container/bot-operateur/config

# Timezone
TZ=Europe/Paris

# Configuration bot (valeurs recommandées pour QNAP)
DEFAULT_STRATEGY=smart
HEADLESS=true
LOG_LEVEL=INFO
MAX_CONCURRENT_MISSIONS=3
MIN_CREDITS_THRESHOLD=1000
OPTIMIZATION_THRESHOLD=3
DEPLOYMENT_THRESHOLD=5
PERSONNEL_THRESHOLD=1

# Timeouts (adaptés pour performances QNAP)
PAGE_LOAD_TIMEOUT=30
ELEMENT_WAIT_TIMEOUT=10
FAST_TIMEOUT=5
SLOW_TIMEOUT=15
BROWSER_SLOW_MO=100

# Retry et stabilité
MAX_RETRIES=3
RETRY_DELAY=2
MISSION_COOLDOWN=5

# Monitoring et logs
ENABLE_PERFORMANCE_LOGS=false