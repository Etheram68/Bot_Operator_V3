# Dockerfile pour Bot Opérateur 112 - Version corrigée
FROM python:3.11-slim

# Métadonnées
LABEL maintainer="Bot Operateur 112"
LABEL description="Bot automatisé pour Opérateur 112 - Compatible QNAP"
LABEL version="1.0"

# Variables d'environnement pour optimisation
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV DEBIAN_FRONTEND=noninteractive
ENV DOCKER_BUILDKIT=1

# Mise à jour et installation des dépendances de base
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    wget \
    curl \
    gnupg \
    ca-certificates \
    git \
    xvfb \
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Pas d'utilisateur spécifique pour éviter les problèmes de permissions
# Le container s'exécutera en root, ce qui est acceptable pour QNAP

# Créer répertoire de travail
WORKDIR /app

# Copier requirements en premier (pour cache Docker)
COPY requirements.txt .

# Installer dépendances Python
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Installer Playwright et Chromium
# On essaie d'abord avec --with-deps, sinon méthode traditionnelle
RUN playwright install chromium && \
    playwright install-deps chromium || \
    (apt-get update && \
     apt-get install -y --no-install-recommends \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libgbm1 \
        libxss1 \
        libasound2 \
        && rm -rf /var/lib/apt/lists/*)

# Copier le code source
COPY . .

# Créer répertoires nécessaires
RUN mkdir -p /app/logs /app/data /app/cache /app/config

# Script d'entrée
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Créer répertoires avec bonnes permissions
RUN chmod -R 755 /app && \
    chmod -R 777 /app/logs /app/data /app/cache /app/config

# Rester en root pour éviter les problèmes de permissions

# Volumes pour persistance données
VOLUME ["/app/logs", "/app/data", "/app/cache", "/app/config"]

# Port d'exposition (si nécessaire pour monitoring)
EXPOSE 8080

# Healthcheck simple
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "print('OK')" || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "main.py", "--continuous"]