# Configuration Ultra-Rapide pour Bot Opérateur 112
# Optimisée pour la vitesse maximale et minimum de temps d'arrêt

# Authentification (à configurer avec vos identifiants)
USERNAME=your_email
PASSWORD=your_password

# Stratégie optimisée pour vitesse
DEFAULT_STRATEGY=smart
MIN_CREDITS_THRESHOLD=0  # Seuil plus bas = plus de missions
OPTIMIZATION_THRESHOLD=3
DEPLOYMENT_THRESHOLD=1
PERSONNEL_THRESHOLD=1

# Performance Ultra-Optimisée - NOUVEAUX TIMEOUTS OPTIMISÉS
HEADLESS=true
PAGE_LOAD_TIMEOUT=15      # Optimisé (réduit de 30s → 15s)
ELEMENT_WAIT_TIMEOUT=3    # Optimisé (réduit de 5s → 3s)
FAST_TIMEOUT=2            # Éléments critiques
SLOW_TIMEOUT=8            # Opérations complexes réduites
BROWSER_SLOW_MO=0         # Vitesse maximale
FAST_NAVIGATION=true      # Navigation optimisée

# Retry Ultra-Rapide (optimisé)
MAX_RETRIES=2             # 2 tentatives (sécurité)
RETRY_DELAY=1             # 1s entre retry (plus stable)
MISSION_COOLDOWN=3

# Logging optimisé pour performance
LOG_LEVEL=INFO
PERFORMANCE_MONITORING=true   # Active monitoring temps réel

# Seuils optimisés pour vitesse
MAX_CONCURRENT_MISSIONS=50     # Optimisé pour systèmes 2GB RAM

# Configuration réseau QNAP (optionnel)
# Adapter selon votre configuration réseau
QNAP_HOST_IP=192.168.1.29
MONITORING_PORT=8081  # Port pour interface web

# Configuration Docker spécifique
COMPOSE_PROJECT_NAME=bot-operateur-112
COMPOSE_FILE=docker-compose.yml

# Chemins de données sur QNAP (adapter selon vos shares)
DATA_PATH=/share/Container/bot-operateur/data
CONFIG_PATH=/share/Container/bot-operateur/config

# Variables d'environnement pour compatibilité
GAME_URL=https://www.operateur112.fr
