# Configuration du bot Opérateur 112

# URL du jeu
GAME_URL=https://www.operateur112.fr

# Credentials
USERNAME=your_username
PASSWORD=your_password

# Timeouts (secondes)
PAGE_LOAD_TIMEOUT=30
ELEMENT_WAIT_TIMEOUT=10
RETRY_DELAY=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Stratégies
DEFAULT_STRATEGY=balanced
AUTO_DEPLOY=true
MIN_CREDITS_THRESHOLD=1000

# Navigation
HEADLESS=true
BROWSER_SLOW_MO=100