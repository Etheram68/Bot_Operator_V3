# Configuration du bot Opérateur 112

# URL du jeu
GAME_URL=https://www.operateur112.fr

# Credentials
USERNAME=your_username
PASSWORD=your_password

# Timeouts (secondes) - Optimisés pour performance
PAGE_LOAD_TIMEOUT=15
ELEMENT_WAIT_TIMEOUT=5
FAST_TIMEOUT=3
SLOW_TIMEOUT=12
RETRY_DELAY=0.5
MAX_RETRIES=1
MISSION_COOLDOWN=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Stratégies
DEFAULT_STRATEGY=smart
AUTO_DEPLOY=true
MIN_CREDITS_THRESHOLD=1000
MAX_CONCURRENT_MISSIONS=30
MISSION_COOLDOWN=5

# Navigation
HEADLESS=true
BROWSER_SLOW_MO=100

# Optimisation des déploiements
# Seuil critique de véhicules : si une solution nécessite plus de N véhicules,
# le système privilégiera un véhicule plus gros même avec plus d'excédent
VEHICLE_THRESHOLD=3