# Configuration du bot Opérateur 112

# URL du jeu
GAME_URL=https://www.operateur112.fr

# Credentials
USERNAME=your_username
PASSWORD=your_password

# Timeouts (secondes) - Optimisés pour performance
PAGE_LOAD_TIMEOUT=15
ELEMENT_WAIT_TIMEOUT=5
FAST_TIMEOUT=3
SLOW_TIMEOUT=12
RETRY_DELAY=0.5
MAX_RETRIES=1
MISSION_COOLDOWN=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Stratégies
DEFAULT_STRATEGY=smart
AUTO_DEPLOY=true
MIN_CREDITS_THRESHOLD=1000
MAX_CONCURRENT_MISSIONS=30
MISSION_COOLDOWN=5

# Navigation
HEADLESS=true
BROWSER_SLOW_MO=100

# Optimisation des déploiements

# DEPRECATED: Utiliser OPTIMIZATION_THRESHOLD et DEPLOYMENT_THRESHOLD
VEHICLE_THRESHOLD=3

# Seuil d'optimisation : privilégier un gros véhicule vs plusieurs petits
# Si une solution nécessite plus de N véhicules, chercher un véhicule plus gros
OPTIMIZATION_THRESHOLD=3

# Seuil de déploiement : skip mission si trop de véhicules manquent  
# Si plus de N véhicules manquent après sélection, ne pas déployer
DEPLOYMENT_THRESHOLD=5

# Seuil critique de personnel spécialisé : si plus de N spécialistes manquent,
# skip la mission car elle sera probablement échec (PLG, GRIMP, MED, etc.)
PERSONNEL_THRESHOLD=1